# 默认无需凭证，不产生模型费用。
AI_PROVIDER=mock
PORT=3001
# 真实模式：AI_PROVIDER=openai；仅服务端读取，不能用VITE_前缀。
OPENAI_API_KEY=
# 指定账户有权访问且支持Responses API结构化输出的模型ID；必须显式填写。
OPENAI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=1800
AI_MAX_CALLS_PER_MINUTE=20
AI_MAX_TOTAL_CALLS=12
# 每轮固定上限30次；失败和手动重试也消耗额度。重启进程会重置本地计数。
# Coze不在本阶段接入，作为单独制作的对照智能体。

# Paid web entry is separately disabled. API credentials alone do not enable it.
ENABLE_PAID_AI=0
AI_ACCESS_CODE=
SESSION_COOKIE_SECRET=
PUBLIC_ORIGIN=
APP_INSTANCES=1
API_RATE_LIMIT=120
API_OWNER_LIMIT=100
TRUST_PROXY_HOPS=0
