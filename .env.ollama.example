# Explicit local mode; no cloud/API Key. Copy manually, default .env.example stays Mock.
AI_PROVIDER=ollama
PORT=3001
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Download explicitly using ollama pull; this app never pulls models.
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_MS=90000
AI_MAX_OUTPUT_TOKENS=1800
AI_MAX_CALLS_PER_MINUTE=10
AI_MAX_TOTAL_CALLS=100
ENABLE_PAID_AI=0
# Separate, manual A-H local evaluation. Off by default.
RUN_LOCAL_AI=0
QUALITY_MAX_REQUESTS=10
