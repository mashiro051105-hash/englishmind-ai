{
  "name": "englishmind-ai",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "test:restart": "node scripts/browser-restart-check.mjs",
    "test:live": "tsx scripts/live-ai-check.ts"
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "openai": "^7.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^8.11.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "playwright-core": "^1.64.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
