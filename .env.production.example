NODE_ENV=production
PORT=3001
AI_PROVIDER=mock
ENABLE_PAID_AI=0
# Use the real HTTPS origin. Render can instead supply RENDER_EXTERNAL_URL.
PUBLIC_ORIGIN=https://replace-with-your-actual-host.example
# Generate a random secret of at least 32 chars; do not commit it.
SESSION_COOKIE_SECRET=
TRUST_PROXY_HOPS=1
APP_INSTANCES=1
API_RATE_LIMIT=120
API_OWNER_LIMIT=100
# Leave blank for public Mock demonstration.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_ACCESS_CODE=
AI_MAX_TOTAL_CALLS=12
AI_MAX_CALLS_PER_MINUTE=6
AI_MAX_OUTPUT_TOKENS=1800
AI_TIMEOUT_MS=20000
